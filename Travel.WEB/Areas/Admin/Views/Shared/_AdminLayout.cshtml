@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?
            .ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?
            .ToString();
}

<!DOCTYPE html>
<html lang="tr">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Travel Admin
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/adminlayout/admin-layout.css"
          asp-append-version="true" />

    @if (currentController == "Route")
    {
        <link rel="stylesheet"
              href="~/css/adminroutecss/route.css"
              asp-append-version="true" />
    }

    @if (currentController == "Reservation")
    {
        <link rel="stylesheet"
              href="~/css/adminreservation/reservation.css"
              asp-append-version="true" />
    }

    @if (currentController == "Review")
    {
        <link rel="stylesheet"
              href="~/css/adminreview/review.css"
              asp-append-version="true" />
    }

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <div class="admin-shell">

        <aside class="admin-sidebar">

            <div class="admin-sidebar-brand">

                <div class="admin-logo">
                    <i class="bi bi-compass"></i>
                </div>

                <div class="admin-brand-text">

                    <div class="admin-brand-title">
                        Travel
                    </div>

                    <div class="admin-brand-subtitle">
                        Admin Panel
                    </div>

                </div>

            </div>


            <nav class="admin-nav">

                <div class="admin-nav-section-title">
                    GENEL
                </div>


            


                <div class="admin-nav-section-title">
                    İÇERİK YÖNETİMİ
                </div>


                <a asp-area="Admin"
                   asp-controller="Route"
                   asp-action="Index"
                   class="admin-nav-link
                   @(currentController == "Route"
                                          ? "active"
                                          : "")">

                    <i class="bi bi-map"></i>

                    <span>
                        Rotalar
                    </span>

                </a>


                <a asp-area="Admin"
                   asp-controller="Banner"
                   asp-action="Index"
                   class="admin-nav-link
                   @(currentController == "Banner"
                                          ? "active"
                                          : "")">

                    <i class="bi bi-images"></i>

                    <span>
                        Bannerlar
                    </span>

                </a>


                <a asp-area="Admin"
                   asp-controller="Review"
                   asp-action="Index"
                   class="admin-nav-link
                   @(currentController == "Review"
                                          ? "active"
                                          : "")">

                    <i class="bi bi-star"></i>

                    <span>
                        Yorumlar
                    </span>

                </a>


                <a asp-area="Admin"
                   asp-controller="Reservation"
                   asp-action="Index"
                   class="admin-nav-link
   @(currentController == "Reservation"
                          ? "active"
                          : "")">

                    <i class="bi bi-calendar-check"></i>

                    <span>
                        Rezervasyonlar
                    </span>

                </a>


             
            </nav>


            <div class="admin-sidebar-footer">

                <div class="admin-sidebar-user">

                    <div class="admin-user-avatar">
                        A
                    </div>

                    <div class="admin-user-info">

                        <div class="admin-user-name">
                            Admin
                        </div>

                        <div class="admin-user-role">
                            Yönetici
                        </div>

                    </div>

                </div>

            </div>

        </aside>


        <div class="admin-main">

            <header class="admin-topbar">

                <div class="admin-topbar-left">

                    <button class="admin-menu-button"
                            type="button"
                            id="adminMenuButton">

                        <i class="bi bi-list"></i>

                    </button>


                    <div class="admin-breadcrumb">

                        <span>
                            Admin
                        </span>

                        <i class="bi bi-chevron-right"></i>

                        <strong>
                            @ViewData["Title"]
                        </strong>

                    </div>

                </div>


                <div class="admin-topbar-right">

                    <button class="admin-topbar-action"
                            type="button">

                        <i class="bi bi-bell"></i>

                        <span class="admin-notification-dot"></span>

                    </button>


                    <a href="/"
                       class="admin-site-button"
                       target="_blank">

                        <i class="bi bi-box-arrow-up-right"></i>

                        <span>Siteyi Görüntüle</span>

                    </a>

                </div>

            </header>


            <main class="admin-content">

                @RenderBody()

            </main>

        </div>

    </div>


    <div class="admin-sidebar-overlay"
         id="adminSidebarOverlay">
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const menuButton =
                document.getElementById("adminMenuButton");

            const sidebar =
                document.querySelector(".admin-sidebar");

            const overlay =
                document.getElementById("adminSidebarOverlay");


            menuButton?.addEventListener("click", function () {

                sidebar?.classList.toggle("open");
                overlay?.classList.toggle("show");

            });


            overlay?.addEventListener("click", function () {

                sidebar?.classList.remove("open");
                overlay?.classList.remove("show");

            });

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>