@model CreateBannerDto

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <h3 class="fw-bold mb-4">Yeni Banner Alanı Ekle</h3>

            <form method="post">

                <div class="mb-3">
                    <label class="form-label">Görsel Url</label>
                    <input type="text"
                           asp-for="ImageUrl"
                           class="form-control" />
                    <span class="text-danger"
                          asp-validation-for="ImageUrl"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Başlık</label>
                    <input type="text"
                           asp-for="Title"
                           class="form-control" />
                    <span class="text-danger"
                          asp-validation-for="Title"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Açıklama</label>
                    <input type="text"
                           asp-for="Description"
                           class="form-control" />
                    <span class="text-danger"
                          asp-validation-for="Description"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Kaydet
                </button>

            </form>

        </div>
    </div>

</div>

<a href="/Admin/Banner/Create"
   class="btn btn-outline-dark">
    Yeni Banner Alanı Ekle
</a>