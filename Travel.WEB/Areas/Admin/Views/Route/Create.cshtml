@using Travel.WEB.DTOs.RouteDTOs
@model CreateRouteDto

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <h3 class="fw-bold mb-4">Yeni Rota Ekle</h3>

            <form method="post">

                <div class="mb-3">
                    <label class="form-label">Şehir</label>
                    <input type="text"
                           asp-for="City"
                           class="form-control" />
                    <span class="text-danger"
                          asp-validation-for="City"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Ülke</label>
                    <input type="text"
                           asp-for="Country"
                           class="form-control" />
                    <span class="text-danger"
                          asp-validation-for="Country"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Süre</label>
                    <input type="text"
                           asp-for="Duration"
                           class="form-control"
                           placeholder="Örn: 5 Gün 4 Gece" />
                    <span class="text-danger"
                          asp-validation-for="Duration"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Görsel Url</label>
                    <input type="text"
                           asp-for="ImageUrl"
                           class="form-control" />
                    <span class="text-danger"
                          asp-validation-for="ImageUrl"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Fiyat</label>
                    <input type="number"
                           asp-for="Price"
                           class="form-control"
                           step="0.01" />
                    <span class="text-danger"
                          asp-validation-for="Price"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Kaydet
                </button>

            </form>

        </div>
    </div>

</div>

<a href="/Admin/Route/Create"
   class="btn btn-outline-dark mt-3">
    Yeni Rota Ekle
</a>
